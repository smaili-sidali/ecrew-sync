# eCrew portal credentials — copy this file to .env and fill in your values.
# NEVER commit the real .env file (it is gitignored).

# Your Air Algérie eCrew crew id (a number).
ECREW_USERNAME=

# Your Air Algérie eCrew password.
ECREW_PASSWORD=

# Base URL of the eCrew portal (no trailing slash).
ECREW_BASE_URL=https://ecrew.airalgerie.dz/ecrew

# File where the eCrewHeader session id is cached between runs.
# This is the shared default for both the CLI and the web server.
ECREW_COOKIE_FILE=session_state.json

# Where the roster JSON store lives.
ECREW_DB_FILE=roster.json

# --- optional tuning ------------------------------------------------------- #

# Hours between automatic background syncs (default 6).
#ECREW_SYNC_INTERVAL_H=6

# Minimum seconds between two syncs, to debounce repeated button presses.
# Set to 0 to disable. Use POST /api/sync?force=1 to bypass for one run.
#ECREW_SYNC_MIN_GAP_S=300

# Timezone the portal's timestamps are expressed in. Algiers is UTC+1 and
# observes no DST. This is what keeps the .ics export from shifting by an hour.
#ECREW_TZ=Africa/Algiers

# Expose /docs and /openapi.json. Leave off for any public deployment —
# it is an unauthenticated map of the whole API.
#ECREW_ENABLE_DOCS=0

# --- security ------------------------------------------------------------- #

# Bearer token required on every /api route (except /api/health and
# /api/contract). Generate one with:  python -m cli.main token
#
# SET THIS before exposing the service to the internet. Without it, anyone who
# can reach the URL can read your roster and trigger real portal logins.
# Send it as "Authorization: Bearer <token>" or "?token=<token>" — the query
# form exists because calendar apps cannot set headers on a subscribed feed.
#ECREW_API_TOKEN=

# --- alerting (Phase 1) ---------------------------------------------------- #

# POSTed as JSON when the roster changes, a sync fails, or the portal contract
# drifts. Point it at ntfy, a Telegram bridge, or your own endpoint.
# Examples:
#   ntfy:  https://ntfy.sh/my-private-topic
#ECREW_WEBHOOK_URL=

# Only notify when something actually changed (rather than on every sync).
#ECREW_NOTIFY_ON_CHANGE=1

#ECREW_WEBHOOK_TIMEOUT_S=10

# --- portal contract canary (Phase 0/1) ------------------------------------ #

# Classify the fetched fragment before trusting it, so a silent portal change
# becomes a loud, actionable error instead of a stale roster. On by default.
#ECREW_CONTRACT_CHECK=1

# Fewer duty-like events than this is treated as a truncated/suspect payload.
#ECREW_CONTRACT_MIN_EVENTS=2

# --- logging (Phase 3) ----------------------------------------------------- #

#ECREW_LOG_LEVEL=INFO

# One JSON object per line, for container log shippers.
#ECREW_LOG_JSON=0