# Replace with your domain. Caddy will fetch a Let's Encrypt certificate
# automatically for any domain it is pointed at.
#
# The API is unauthenticated: it serves your roster to anyone who can reach
# this origin. The commented basic_auth block below is the cheapest way to put
# a lock on it. To enable:
#
#   1. caddy hash-password --plaintext 'your-password'   -> paste the hash here
#   2. Uncomment the basicauth block
#
# Alternatively terminate TLS in front of a private network / VPN instead.
roster.example.com {
    encode gzip

    # basicauth * {
    #     crew $2a$14$YOUR_HASH_HERE
    # }

    reverse_proxy ecrew-sync:8000
}
