# Secrets / credentials
.env
*.key
*.pem

# Stored session / cookies
cookies.json
cookies_*.json
session_*.pkl

# Local data / cache
*.db
*.sqlite
*.sqlite3
data/

# Roster store + cached session id.
# These are the *local* defaults from backend/config.py and they contain real
# personal duty data and a live session UUID. Without these entries a plain
# `git add -A` (which the README recommends) publishes them to a public repo.
roster.json
session_state.json
# Personal crew data written next to the roster store by backend/leave.py and
# backend/training.py: leave balance/history/bids, seniority, and medical +
# licence expiry dates. Both modules seed themselves from the defaults in code
# when the file is missing, so there is no reason to track them.
leave.json
qualifications.json
*.ics
*.tmp
*.apk
dist-apk/

# Debug artifacts (raw HTML from failed parses)
debug_*.html
debug_*.txt

# Android TWA build artifacts (generated by `bubblewrap init` / `build`)
# NEVER commit the signing keystore.
twa/app/
twa/android/
twa/dist/
twa/gradlew
twa/gradlew.bat
twa/gradle/
twa/build/
